// Schema inicial — cobre o necessário para o módulo de autenticação.
// Os demais campos do dossiê da unidade (vistorias, avaliações, apontamentos,
// histórico) entram no próximo módulo (Cadastro de Unidades).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empreendimento {
  id          String    @id @default(cuid())
  nome        String
  estagioAtual String   @default("Início da Jornada")
  // Banner do painel do investidor + página "Conheça sua jornada" (editados pela equipe)
  bannerImagemBase64  String?
  dataLancamento      DateTime?
  dataEntregaPrevista DateTime?
  progressoPercentual Int       @default(0) // 0-100, atualizado manualmente pela equipe
  jornadaTitulo       String?
  jornadaConteudo     String?
  etapa        String   @default("construcao") // lancamento | assinatura | construcao | entrega_chaves
  unidades    Unidade[]
  atualizacoes AtualizacaoEstagio[]
  documentoTemplates DocumentoTemplate[]
  createdAt   DateTime  @default(now())
}

model Unidade {
  id               String               @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento       @relation(fields: [empreendimentoId], references: [id])
  bloco            String
  numero           String
  status           String               @default("regularizado") // regularizado | troca_titularidade | distrato
  tipologia        String?              // ex: "2 QUARTOS", "3 QUARTOS" — vem da base de entrega de chaves
  grupo            String?              // A | B — grupo de entrega de chaves (base Murano)
  statusQuitacao   String?              // quitada | a_vencer — status de pagamento (base Murano)
  compradores      Json?                // [{ nome: String, principal: Boolean }] — fonte dos documentos de entrega
  observacoes      String?              // anotações livres do dossiê
  // Entrega de chaves — status financeiro/jurídico (editado pela equipe no dossiê)
  financiado          Boolean           @default(false)
  grupoFinanciamento  String?           // A | B (nulo se não financiado)
  vistoriaAprovada    Boolean           @default(false)
  escrituraRegistrada Boolean           @default(false) // apenas consulta/exibição por enquanto
  quartos             Int?              // tipologia (2 ou 3) — define chaves de porta interior no checklist
  investidores     UnidadeInvestidor[]
  historico        HistoricoUnidade[]
  agendamentos     Agendamento[]
  presencas        PresencaEntrega[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([empreendimentoId, bloco, numero])
}

// Linha do tempo da unidade — "a unidade não é só o CPF": todo evento relevante
// fica registrado aqui, independente de quem é o investidor no momento.
model HistoricoUnidade {
  id          String   @id @default(cuid())
  unidadeId   String
  unidade     Unidade  @relation(fields: [unidadeId], references: [id])
  tipo        String   // cadastro | vistoria | avaliacao | apontamento | evento_realizado | documento | outro
  descricao   String
  criadoPorId String?  // Funcionario.id, quando aplicável
  createdAt   DateTime @default(now())
}

model Investidor {
  id              String              @id @default(cuid())
  nome            String
  cpf             String              @unique
  senhaHash       String
  primeiroAcesso  Boolean             @default(true)
  termoAceitoEm   DateTime?
  tutorialVisto   Boolean             @default(false)
  unidades        UnidadeInvestidor[]
  sessoes         Sessao[]
  agendamentos    Agendamento[]
  createdAt       DateTime            @default(now())
}

// Até 3 investidores por unidade; cada um com seu próprio e-mail de contato.
model UnidadeInvestidor {
  id           String     @id @default(cuid())
  unidadeId    String
  investidorId String
  email        String
  unidade      Unidade    @relation(fields: [unidadeId], references: [id])
  investidor   Investidor @relation(fields: [investidorId], references: [id])

  @@unique([unidadeId, investidorId])
}

// --- Atualizações da obra (engajamento) ---

model AtualizacaoEstagio {
  id               String         @id @default(cuid())
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  titulo           String
  descricao        String
  midiaBase64      String?        // foto do marco (opcional) — mesma limitação do documento: base64 até trocar por S3/R2
  publicadoPorId   String
  publicadoPor     Funcionario    @relation(fields: [publicadoPorId], references: [id])
  emails           EmailEnviado[]
  createdAt        DateTime       @default(now())
}

// Log de disparo — auditoria de quem recebeu cada atualização.
model EmailEnviado {
  id            String             @id @default(cuid())
  atualizacaoId String
  atualizacao   AtualizacaoEstagio @relation(fields: [atualizacaoId], references: [id])
  investidorId  String
  email         String
  enviado       Boolean            @default(true)
  erro          String?
  abertoEm      DateTime?          // marcado quando o pixel de abertura é carregado
  clicadoEm     DateTime?          // marcado quando o link de "acompanhar" é clicado
  createdAt     DateTime           @default(now())
}

// --- Agendamento ---

// Módulo configurável de tipos de evento (não hardcoded) — hoje cobre os 5
// tipos definidos no escopo, mas permite adicionar outros no futuro.
model TipoEvento {
  id              String        @id @default(cuid())
  slug            String        @unique // visita-obra | vistoria | escritura | entrega-chaves | atendimento
  nome            String
  exigeDocumento  Boolean       @default(false)
  limitePessoas   Int           @default(4) // total de pessoas (investidor + acompanhantes)
  ativo           Boolean       @default(true)
  ordem           Int           @default(0)
  agendamentos    Agendamento[]
}

model Agendamento {
  id              String         @id @default(cuid())
  unidadeId       String
  unidade         Unidade        @relation(fields: [unidadeId], references: [id])
  tipoEventoId    String
  tipoEvento      TipoEvento     @relation(fields: [tipoEventoId], references: [id])
  investidorId    String         // quem fez o agendamento
  investidor      Investidor     @relation(fields: [investidorId], references: [id])
  dataHora        DateTime
  status          String         @default("confirmado") // confirmado | cancelado | realizado
  qrToken         String         @unique
  // Documento de identificação do investidor (base64) — enquanto não há
  // armazenamento de arquivos (S3/R2) configurado; trocar por upload real
  // quando a infraestrutura de storage entrar.
  documentoBase64 String?
  // ID do evento criado no Google Calendar da Calper — usado pra apagar o
  // evento se o agendamento for cancelado, e nulo enquanto a integração
  // não estiver configurada (nesse caso o agendamento segue normalmente).
  googleEventId   String?
  // Evita mandar o lembrete da véspera mais de uma vez caso o cron rode de novo.
  lembreteEnviado Boolean        @default(false)
  // Entrega de chaves (agendamento público, sem login): quem vai comparecer.
  // Nulos nos demais tipos de evento.
  nomeCompareceu     String?
  cpfCompareceu      String?
  telefoneCompareceu String?
  emailCompareceu    String?
  ehProprietario     Boolean?
  // Quem agendou fica nos campos *Compareceu acima (intactos). Quem retira as chaves de fato é
  // confirmado no dia, no passo 2 do fluxo de entrega, e gravado aqui.
  retiranteNome      String?
  retiranteEmail     String?
  retiranteCpf       String?
  procuracaoBase64   String?
  acompanhantes   Acompanhante[]
  documentosAssinados DocumentoAssinado[]
  presencas           PresencaEntrega[]
  pesquisa        PesquisaSatisfacao?
  createdAt       DateTime       @default(now())

  @@index([unidadeId, tipoEventoId, status])
}

// --- Notificações internas (sino) ---
// Guarda um registro visível no sistema pra cada evento relevante, além do
// e-mail (quando aplicável) — assim a pessoa não depende só da caixa de
// entrada pra saber o que aconteceu. Sem relação formal com Investidor/
// Funcionario (só um dos dois ids é preenchido) pra não exigir dois campos
// opcionais de relação só pra isso.
model Notificacao {
  id               String   @id @default(cuid())
  destinatarioTipo String   // investidor | funcionario
  investidorId     String?
  funcionarioId    String?
  titulo           String
  mensagem         String
  link             String?
  lida             Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([investidorId, lida])
  @@index([funcionarioId, lida])
}

// Pesquisa pós-visita — baseada no formulário usado hoje pela Calper (Google Forms).
// Escala de 5 pontos: otimo | muito_bom | bom | ruim | pessimo
model PesquisaSatisfacao {
  id                     String      @id @default(cuid())
  agendamentoId          String      @unique
  agendamento            Agendamento @relation(fields: [agendamentoId], references: [id])
  educacaoFuncionarios   String
  organizacaoLimpeza     String
  expectativasAndamento  String
  clarezaInformacoes     String
  acabamentoObra         String
  atendidoNoHorario      Boolean
  indicariaCalper        Boolean
  pontosFortes           String?
  oportunidadesMelhoria  String?
  createdAt              DateTime    @default(now())
}

model Acompanhante {
  id              String      @id @default(cuid())
  agendamentoId   String
  agendamento     Agendamento @relation(fields: [agendamentoId], references: [id])
  nome            String
  documentoBase64 String?     // opcional — documento de identificação do acompanhante
}

model Sessao {
  id           String     @id // token da sessão
  investidorId String
  investidor   Investidor @relation(fields: [investidorId], references: [id])
  unidadeId    String?    // unidade selecionada nesta sessão (quando há mais de uma)
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
}

// --- Time Calper (painel admin) ---

model Funcionario {
  id        String            @id @default(cuid())
  nome      String
  email     String            @unique
  senhaHash String
  perfil    String            @default("atendimento") // admin | gestao | atendimento
  ativo     Boolean           @default(true)
  sessoes   SessaoFuncionario[]
  lotes     ImportacaoLote[]
  atualizacoesPublicadas AtualizacaoEstagio[]
  createdAt DateTime          @default(now())
}

model SessaoFuncionario {
  id            String      @id // token da sessão
  funcionarioId String
  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id])
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
}

// Registro de cada rodada de importação em massa (auditoria + senhas temporárias geradas).
model ImportacaoLote {
  id            String      @id @default(cuid())
  nomeArquivo   String
  totalLinhas   Int
  unidadesCriadas Int
  investidoresCriados Int
  erros         Json?       // linhas que não puderam ser importadas, com o motivo
  credenciais   Json?       // [{ nome, cpf, email, senhaTemporaria }] geradas nesse lote
  criadoPorId   String
  criadoPor     Funcionario @relation(fields: [criadoPorId], references: [id])
  createdAt     DateTime    @default(now())
}


// --- Entrega de chaves: documentos ---

// Texto editável pela equipe (variáveis entre {{ }}). Um por tipo e empreendimento.
model DocumentoTemplate {
  id               String         @id @default(cuid())
  tipo             String         // checklist | termo_entrega_chaves
  empreendimentoId String
  empreendimento   Empreendimento @relation(fields: [empreendimentoId], references: [id])
  conteudo         String
  // valores fixos do empreendimento usados nas variáveis (ex: numeroCertidao, dataAssembleia)
  variaveis        Json?
  atualizadoEm     DateTime       @updatedAt

  @@unique([empreendimentoId, tipo])
}

// Documento enviado ao DocuSign. Fica "pendente" até a assinatura ser concluída e o PDF baixado.
model DocumentoAssinado {
  id                 String      @id @default(cuid())
  agendamentoId      String
  agendamento        Agendamento @relation(fields: [agendamentoId], references: [id])
  tipo               String      // checklist | termo
  status             String      @default("pendente") // pendente | assinado
  pdfBase64          String?     // PDF assinado (data URL); nulo enquanto pendente
  docusignEnvelopeId String
  assinadoEm         DateTime?
  createdAt          DateTime    @default(now())

  @@unique([agendamentoId, tipo])
}

// --- Auditoria ---

// Quem fez o quê no sistema. Sem FK de propósito: o log sobrevive à remoção do ator/entidade.
// Retenção: índices por data prontos pra uma limpeza futura (deleteMany where createdAt < X).
model LogAcesso {
  id            String   @id @default(cuid())
  atorTipo      String   // investidor | funcionario
  investidorId  String?
  funcionarioId String?
  acao          String   // login | logout | login_falhou | agendamento_criado | ...
  descricao     String   // frase legível
  entidadeTipo  String?  // Agendamento | Unidade | DocumentoAssinado ...
  entidadeId    String?
  ip            String?
  userAgent     String?
  createdAt     DateTime @default(now())

  @@index([investidorId, createdAt])
  @@index([funcionarioId, createdAt])
  @@index([acao, createdAt])
  @@index([createdAt])
}

// Lista de presença da entrega de chaves: quem compareceu, com qual vínculo e a que horas.
model PresencaEntrega {
  id             String      @id @default(cuid())
  agendamentoId  String
  agendamento    Agendamento @relation(fields: [agendamentoId], references: [id])
  unidadeId      String
  unidade        Unidade     @relation(fields: [unidadeId], references: [id])
  nome           String
  vinculo        String      // comprador_principal | comprador | procurador | acompanhante
  cpf            String?
  registradoPorId String?    // Funcionario.id
  createdAt      DateTime    @default(now()) // horário em que a presença foi registrada

  @@index([agendamentoId])
  @@index([unidadeId])
  @@index([createdAt])
}
